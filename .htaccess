# Optioneel, enkel als het VOLLEDIGE project in de webroot staat (bv. snelle installatie op een (sub)domein):
# schermt de interne mappen af en laat de urls zonder /public/ werken. De app zelf heeft geen rewrites nodig.
# Op assurio.be staat enkel public/ in de webroot en de rest erbuiten: daar wordt dit bestand niet gebruikt.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Interne mappen blokkeren
    RewriteRule ^(config|database|features|lang|src|storage|views|bin|dist|mcp-crashcourse)(/|$) - [F,L]

    # Alles doorsturen naar public/
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "\.(sql|sqlite|log|md)$">
    Require all denied
</FilesMatch>
